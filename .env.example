# 청첩장 기본 정보. .env.local로 복사해서 값을 채운다.
# NEXT_PUBLIC_ 값은 빌드 시점에 번들에 박히므로, 바꾼 뒤에는 dev 서버 재시작 / 재배포가 필요하다.
# 값을 비우거나 키가 없으면 임시 값(김아무개, 010-0000-0000, 아무개웨딩홀 …)이 들어간다.

# 신랑 측
NEXT_PUBLIC_GROOM_NAME=
NEXT_PUBLIC_GROOM_PHONE=
NEXT_PUBLIC_GROOM_FATHER_NAME=
NEXT_PUBLIC_GROOM_FATHER_PHONE=
NEXT_PUBLIC_GROOM_MOTHER_NAME=
NEXT_PUBLIC_GROOM_MOTHER_PHONE=

# 신부 측
NEXT_PUBLIC_BRIDE_NAME=
NEXT_PUBLIC_BRIDE_PHONE=
NEXT_PUBLIC_BRIDE_FATHER_NAME=
NEXT_PUBLIC_BRIDE_FATHER_PHONE=
NEXT_PUBLIC_BRIDE_MOTHER_NAME=
NEXT_PUBLIC_BRIDE_MOTHER_PHONE=

# 예식 일시 (KST)
NEXT_PUBLIC_WEDDING_DATE=2027-06-20
NEXT_PUBLIC_WEDDING_TIME=11:00

# 예식 장소
NEXT_PUBLIC_VENUE_NAME=
NEXT_PUBLIC_VENUE_HALL=
NEXT_PUBLIC_VENUE_ADDRESS=
NEXT_PUBLIC_VENUE_TEL=

# 배포 주소 (카카오톡 등 링크 미리보기 이미지에 필요). Vercel이면 비워도 운영 도메인을 자동으로 쓴다
NEXT_PUBLIC_SITE_URL=

# 기능 켜기/끄기 (true/false, 비우면 기본값)
# 첫 진입 인트로 애니메이션 (기본 true). false면 바로 청첩장이 보이고 '인트로 다시 보기' 버튼도 숨겨진다
NEXT_PUBLIC_INTRO_ENABLED=true
